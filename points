#!/usr/bin/env bash
# points — Capital One Venture X deal hunter (single entry point).
# Supports the Venture X card only for now.
set -euo pipefail
cd "$(dirname "$0")"
PY=".venv/bin/python"

load_env() { if [[ -f .env ]]; then set -a; source .env; set +a; fi; }
latest_offers() { ls -t data/offers_2*.json 2>/dev/null | head -1; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  login)
    # one-time Capital One sign-in (saves the session to pw_profile/)
    "$PY" src/scrape.py --login ;;

  scan)
    # scrape all offers + score, no per-merchant pricing (fast)
    "$PY" src/scrape.py
    "$PY" src/score.py "$(latest_offers)" ;;

  hunt)
    # price unpriced opportunities via render + LLM judge (passes flags through)
    load_env
    "$PY" src/autohunt.py "$@" ;;

  stream)
    # decoupled render (producer) -> judge (consumers) via Kafka.
    # requires a broker:  docker compose up -d
    load_env
    "$PY" src/stream_pipeline.py "$@" ;;

  stream2)
    # two-stage pipeline: feed -> classify (flat + single-purchase) -> price -> rate.
    # requires a broker:  docker compose up -d  (run ./points scan first for offers)
    load_env
    "$PY" src/stream_pipeline2.py "$@" ;;

  watch)
    # continuous poll -> real-time alert on newly-appeared flat offers.
    # requires a broker:  docker compose up -d
    load_env
    "$PY" src/stream_watch.py "$@" ;;

  run)
    # full daily pipeline: scrape -> hunt -> report + notify
    load_env
    "$PY" src/scrape.py
    "$PY" src/autohunt.py ;;

  report)
    # print the latest report
    r="$(ls -t reports/report_*.md 2>/dev/null | head -1)"
    [[ -n "$r" ]] && cat "$r" || echo "no report yet — run: ./points run" ;;

  *)
    cat <<'EOF'
points — Capital One Venture X deal hunter

Flat offers get devalued and pulled fast, so the PRIMARY mode is real-time:
watch the feed continuously and get pushed the moment a new flat deal lands.

usage: ./points <command>

  REAL-TIME (recommended) — needs a broker: docker compose up -d
  watch    ⭐ continuous poll -> instant phone/desktop alert on new flat deals
  stream2  two-stage Kafka: feed -> flat+single-purchase filter -> price -> rate
  stream   decoupled render (producer) -> LLM judges (consumers) via Kafka

  ON-DEMAND (batch, for a one-off sweep)
  scan     scrape all offers + score, no pricing (fast)
  hunt     price opportunities via render + LLM (ProcessPool)
  run      full one-shot pipeline: scrape -> hunt -> report + notification
  report   print the latest report

  SETUP
  login    sign into Capital One once (saves your session)

Setup: echo "MODEL_API_KEY=your-key" > .env  (add NTFY_TOPIC for phone push)
Ops:   ./doctor  (health check + restart)   ·   RUNBOOK.md
Card:  Venture X only (for now).
EOF
    ;;
esac
