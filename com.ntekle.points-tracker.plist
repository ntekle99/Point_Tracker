<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ntekle.points-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ntekle/Desktop/points_tracker/daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ntekle/Desktop/points_tracker</string>

    <!-- Run every day at 8:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ntekle/Desktop/points_tracker/data/daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ntekle/Desktop/points_tracker/data/daily.log</string>

    <!-- if the Mac was asleep at 8am, run once it wakes -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
